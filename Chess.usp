#CATEGORY "31" // Digital Operations
#USER_SIMPLSHARP_LIBRARY "ChessGames"

// Scalar digital inputs
DIGITAL_INPUT Start_Two_Player;
DIGITAL_INPUT Start_One_Player_White;
DIGITAL_INPUT Start_One_Player_Black;
DIGITAL_INPUT Resign_White;
DIGITAL_INPUT Resign_Black;
DIGITAL_INPUT Promo_Choose_Queen;
DIGITAL_INPUT Promo_Choose_Rook;
DIGITAL_INPUT Promo_Choose_Bishop;
DIGITAL_INPUT Promo_Choose_Knight;
DIGITAL_INPUT Promo_Cancel;

// Scalar digital outputs
DIGITAL_OUTPUT Game_Over_Fb;
DIGITAL_OUTPUT Promotion_Prompt_Fb;

// Scalar serial outputs
STRING_OUTPUT Last_Move$;
STRING_OUTPUT Status_Text$;
STRING_OUTPUT Captured_By_White$;
STRING_OUTPUT Captured_By_Black$;

// Array joins (after all scalars)
DIGITAL_INPUT Square_Press[64];
DIGITAL_OUTPUT Square_Selected_Fb[64];
STRING_OUTPUT Square_Icon_Path$[64];
STRING_OUTPUT Captured_White_Icon$[15];
STRING_OUTPUT Captured_Black_Icon$[15];

Chess game;

INTEGER nSelectedSquare;
INTEGER nPendingFromIndex;
INTEGER nPendingToIndex;
STRING sPendingPromoLetter[2];
STRING sLegalMaskGlobal[65];
INTEGER bCpuEnabled;
INTEGER bCpuIsWhite;
INTEGER nGameGeneration;
INTEGER nPendingMoveGeneration;
INTEGER bWhiteToMove;

STRING_FUNCTION IndexToAlgebraic(INTEGER idx)
{
    STRING sFiles[9];
    INTEGER row, col;
    STRING result[4];
    sFiles = "abcdefgh";
    row = (idx - 1) / 8;
    col = (idx - 1) MOD 8;
    result = MID(sFiles, col + 1, 1) + ITOA(8 - row);
    RETURN (result);
}

STRING_FUNCTION PieceCodeToIconPath(STRING code)
{
    IF (code = "P") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/wP.png");
    IF (code = "N") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/wN.png");
    IF (code = "B") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/wB.png");
    IF (code = "R") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/wR.png");
    IF (code = "Q") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/wQ.png");
    IF (code = "K") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/wK.png");
    IF (code = "p") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/bP.png");
    IF (code = "n") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/bN.png");
    IF (code = "b") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/bB.png");
    IF (code = "r") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/bR.png");
    IF (code = "q") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/bQ.png");
    IF (code = "k") RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/bK.png");
    RETURN ("https://raw.githubusercontent.com/JJ0609/CrestronChess/ddb1ae91433b0497b33732fed2264e159f4a2d73/blank.png");
}

INTEGER_FUNCTION IsPromotionMove(INTEGER fromIdx, INTEGER toIdx, STRING boardSquares)
{
    STRING pieceChar[2];
    pieceChar = MID(boardSquares, fromIdx, 1);
    IF (pieceChar = "P")
    {
        IF (toIdx <= 8) RETURN (1);
    }
    IF (pieceChar = "p")
    {
        IF (toIdx >= 57) RETURN (1);
    }
    RETURN (0);
}

FUNCTION RefreshUI()
{
    INTEGER i;
    INTEGER isLegal;
    STRING boardSquares[65];
    STRING codeChar[2];
    STRING capturedWhite[16];
    STRING capturedBlack[16];
    INTEGER lenWhite, lenBlack;
    INTEGER j;
    STRING capturedChar[2];

    boardSquares = game.GetBoardSquares();
    Last_Move$ = game.GetLastMove();
    Status_Text$ = game.GetStatusText();
    bWhiteToMove = game.GetWhiteToMove();
    Game_Over_Fb = game.GetGameOver();

    FOR (i = 1 TO 64)
    {
        codeChar = MID(boardSquares, i, 1);
        Square_Icon_Path$[i] = PieceCodeToIconPath(codeChar);

        IF (nSelectedSquare = i)
        {
            Square_Selected_Fb[i] = 1;
        }
        ELSE
        {
            isLegal = 0;
            IF (nSelectedSquare > 0)
            {
                isLegal = (MID(sLegalMaskGlobal, i, 1) = "1");
            }
            Square_Selected_Fb[i] = isLegal;
        }
    }

    capturedWhite = game.GetCapturedByWhite();
    capturedBlack = game.GetCapturedByBlack();
    Captured_By_White$ = capturedWhite;
    Captured_By_Black$ = capturedBlack;
    lenWhite = LEN(capturedWhite);
    lenBlack = LEN(capturedBlack);

    FOR (j = 1 TO 15)
    {
        IF (j <= lenWhite)
        {
            capturedChar = MID(capturedWhite, j, 1);
            Captured_White_Icon$[j] = PieceCodeToIconPath(capturedChar);
        }
        ELSE
        {
            Captured_White_Icon$[j] = PieceCodeToIconPath(".");
        }

        IF (j <= lenBlack)
        {
            capturedChar = MID(capturedBlack, j, 1);
            Captured_Black_Icon$[j] = PieceCodeToIconPath(capturedChar);
        }
        ELSE
        {
            Captured_Black_Icon$[j] = PieceCodeToIconPath(".");
        }
    }
}

FUNCTION MaybeCpuMove()
{
    INTEGER delayTime;

    IF (bCpuEnabled = 1)
    {
        IF (Game_Over_Fb = 0)
        {
            delayTime = 300; // fixed 1.5 second delay

            nPendingMoveGeneration = nGameGeneration;

            IF (bCpuIsWhite = 1)
            {
                IF (bWhiteToMove = 1)
                {
                    WAIT (delayTime)
                    {
                        IF (nPendingMoveGeneration = nGameGeneration)
                        {
                            game.MakeCpuMove();
                            RefreshUI();
                        }
                    }
                }
            }
            ELSE
            {
                IF (bWhiteToMove = 0)
                {
                    WAIT (delayTime)
                    {
                        IF (nPendingMoveGeneration = nGameGeneration)
                        {
                            game.MakeCpuMove();
                            RefreshUI();
                        }
                    }
                }
            }
        }
    }
}

FUNCTION StartGame(INTEGER cpuEnabled, INTEGER cpuIsWhite)
{
    nGameGeneration = nGameGeneration + 1;
    nSelectedSquare = 0;
    sLegalMaskGlobal = "";
    Promotion_Prompt_Fb = 0;
    bCpuEnabled = cpuEnabled;
    bCpuIsWhite = cpuIsWhite;
    game.NewGame();
    RefreshUI();
    MaybeCpuMove();
}

FUNCTION CompletePromotion()
{
    STRING fromAlg[4];
    STRING toAlg[4];
    fromAlg = IndexToAlgebraic(nPendingFromIndex);
    toAlg = IndexToAlgebraic(nPendingToIndex);
    game.MakeMove(fromAlg, toAlg, sPendingPromoLetter);
    Promotion_Prompt_Fb = 0;
    nPendingFromIndex = 0;
    nPendingToIndex = 0;
    RefreshUI();
    MaybeCpuMove();
}

FUNCTION HandleSquarePress(INTEGER idx)
{
    STRING fromAlg[4];
    STRING toAlg[4];
    STRING legalMask[65];
    STRING boardSquares[65];
    IF (Promotion_Prompt_Fb = 1) RETURN;
    IF (nSelectedSquare = 0)
    {
        fromAlg = IndexToAlgebraic(idx);
        legalMask = game.GetLegalDestinationMask(fromAlg);
        IF (FIND("1", legalMask, 1) > 0)
        {
            nSelectedSquare = idx;
            sLegalMaskGlobal = legalMask;
            RefreshUI();
        }
    }
    ELSE IF (idx = nSelectedSquare)
    {
        nSelectedSquare = 0;
        sLegalMaskGlobal = "";
        RefreshUI();
    }
    ELSE
    {
        fromAlg = IndexToAlgebraic(nSelectedSquare);
        toAlg = IndexToAlgebraic(idx);
        boardSquares = game.GetBoardSquares();
        IF (IsPromotionMove(nSelectedSquare, idx, boardSquares) = 1)
        {
            nPendingFromIndex = nSelectedSquare;
            nPendingToIndex = idx;
            Promotion_Prompt_Fb = 1;
        }
        ELSE
        {
            game.MakeMove(fromAlg, toAlg, "");
        }
        nSelectedSquare = 0;
        sLegalMaskGlobal = "";
        RefreshUI();

        IF (Promotion_Prompt_Fb = 0)
        {
            MaybeCpuMove();
        }
    }
}

PUSH Start_Two_Player       { StartGame(0, 0); }
PUSH Start_One_Player_White { StartGame(1, 0); }
PUSH Start_One_Player_Black { StartGame(1, 1); }

PUSH Resign_White { game.Resign(1); RefreshUI(); }
PUSH Resign_Black { game.Resign(0); RefreshUI(); }

PUSH Square_Press
{
    INTEGER idx;
    idx = GetLastModifiedArrayIndex();
    HandleSquarePress(idx);
}

PUSH Promo_Choose_Queen  { sPendingPromoLetter = "Q"; CompletePromotion(); }
PUSH Promo_Choose_Rook   { sPendingPromoLetter = "R"; CompletePromotion(); }
PUSH Promo_Choose_Bishop { sPendingPromoLetter = "B"; CompletePromotion(); }
PUSH Promo_Choose_Knight { sPendingPromoLetter = "N"; CompletePromotion(); }

PUSH Promo_Cancel
{
    Promotion_Prompt_Fb = 0;
    nPendingFromIndex = 0;
    nPendingToIndex = 0;
}
